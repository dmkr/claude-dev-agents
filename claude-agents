#!/usr/bin/env bash
# claude-agents — local multi-agent dev setup driven by `claude -p`.
#
# Usage:
#   claude-agents setup            one-time machine wiring (global CLAUDE.md, daily miner)
#   claude-agents install [PATH]   install git hooks into a repo (default: cwd)
#   claude-agents uninstall        remove machine wiring (repo hooks stay)
#   claude-agents mine             run the cross-repo lesson miner now
#   claude-agents sync             sync lessons into the current repo
#   claude-agents ask "question"   ask about the current codebase
#   claude-agents review [SPEC]    review changes without pushing (--staged | RANGE)
#   claude-agents pr [gh args]     open a PR with the generated .git/PR_BODY.md
#   claude-agents status           health check
#   claude-agents doctor           verify dependencies
#
# This script lives next to its data (CLAUDE.md, the plist) and its helper
# scripts. Brew installs the whole tree into libexec/ and symlinks bin/, so the
# helpers sit in the same directory; in a repo checkout they're in libexec/.
set -euo pipefail

VERSION="1.1.2"

# Resolve our own location, following symlinks (brew links into bin/).
SELF="${BASH_SOURCE[0]}"
while [ -L "$SELF" ]; do
  _target="$(readlink "$SELF")"
  case "$_target" in
    /*) SELF="$_target" ;;
    *)  SELF="$(cd "$(dirname "$SELF")" && pwd)/$_target" ;;
  esac
done
PREFIX="$(cd "$(dirname "$SELF")" && pwd)"
# Installed layout: helpers are flat beside us. Checkout: they're in libexec/.
if [ -z "${CLAUDE_AGENTS_LIBEXEC:-}" ] && [ -d "$PREFIX/libexec" ]; then
  LIBEXEC="$PREFIX/libexec"
else
  LIBEXEC="${CLAUDE_AGENTS_LIBEXEC:-$PREFIX}"
fi

LESSONS_DIR="${LESSONS_DIR:-$HOME/.claude/lessons}"
PLIST_LABEL="com.user.mine-all-repos"

c_ok()   { printf '  \033[32m✓\033[0m %s\n' "$1"; }
c_info() { printf '  \033[36m•\033[0m %s\n' "$1"; }
c_warn() { printf '  \033[33m!\033[0m %s\n' "$1"; }
c_bad()  { printf '  \033[31m✗\033[0m %s\n' "$1"; }
die()    { printf '\033[31merror:\033[0m %s\n' "$1" >&2; exit 1; }

# Prefer Homebrew's stable opt/ path for hook symlinks so they survive upgrades
# (the versioned Cellar path changes each release and would leave dangling links).
hook_libexec() {
  case "$LIBEXEC" in
    */Cellar/claude-agents/*/libexec)
      local opt; opt="$(brew --prefix 2>/dev/null)/opt/claude-agents/libexec"
      [ -d "$opt" ] && { echo "$opt"; return; } ;;
  esac
  echo "$LIBEXEC"
}

# ---------------------------------------------------------------- doctor
# Pass --no-probe to skip the live model call (used by setup, which only needs
# the dependency check and shouldn't spend a `claude -p` call to get it).
cmd_doctor() {
  echo "Dependencies:"
  local ok=0
  for c in claude gh jq git; do
    if command -v "$c" >/dev/null 2>&1; then c_ok "$c  ($(command -v "$c"))"
    else c_bad "$c  not found"; ok=1; fi
  done
  if command -v gh >/dev/null 2>&1; then
    if gh auth status >/dev/null 2>&1; then c_ok "gh authenticated"
    else c_warn "gh not authenticated — run: gh auth login"; ok=1; fi
  fi

  if [ "${1:-}" != "--no-probe" ] && command -v claude >/dev/null 2>&1; then
    echo
    echo "Review model:"
    # shellcheck source=libexec/lib.sh
    . "$LIBEXEC/lib.sh"
    c_info "resolved: $CLAUDE_AGENTS_MODEL_LABEL"
    if [ -z "$CLAUDE_AGENTS_MODEL" ]; then
      c_info "set CLAUDE_AGENTS_MODEL to a fast model id to cut review latency/cost"
    fi
    # The hooks fail open, so a model id this backend doesn't recognise looks
    # exactly like a clean review. One real call is the only way to tell them
    # apart — which is why this probe exists rather than just printing the id.
    local raw err
    raw="$(printf 'Reply with the single word: ok' | claude_raw)"
    err="$(claude_error "$raw")"
    if [ -n "$err" ]; then
      c_bad "model call failed — $err"
      c_warn "hooks fail open: reviews would be skipped silently, not blocked"
      ok=1
    elif [ -z "$raw" ]; then
      c_bad "no response within ${CLAUDE_AGENTS_TIMEOUT}s — raise CLAUDE_AGENTS_TIMEOUT"
      ok=1
    else
      c_ok "model call succeeded"
    fi
  fi

  echo
  [ "$ok" -eq 0 ] && c_ok "all good" || c_warn "fix the above, then re-run"
  return $ok
}

# ---------------------------------------------------------------- setup
cmd_setup() {
  echo "Machine setup:"
  cmd_doctor --no-probe >/dev/null 2>&1 || { cmd_doctor --no-probe; die "dependencies missing"; }
  c_ok "dependencies present"

  mkdir -p "$HOME/.claude" "$LESSONS_DIR"
  if [ -f "$HOME/.claude/CLAUDE.md" ] && ! cmp -s "$PREFIX/CLAUDE.md" "$HOME/.claude/CLAUDE.md"; then
    cp "$HOME/.claude/CLAUDE.md" "$HOME/.claude/CLAUDE.md.bak"
    c_info "backed up existing CLAUDE.md -> CLAUDE.md.bak"
  fi
  cp "$PREFIX/CLAUDE.md" "$HOME/.claude/CLAUDE.md"
  c_ok "global CLAUDE.md -> ~/.claude/CLAUDE.md"
  c_ok "lessons library -> $LESSONS_DIR"

  # Model ids differ per backend (first-party vs Bedrock vs Vertex) and, on
  # Bedrock, per account. Probe for one that actually works and record it, so
  # the hooks don't fall back to an id this machine will 404 on — which they
  # would swallow, since they fail open.
  # Capture before sourcing: lib.sh *resolves* CLAUDE_AGENTS_MODEL to a default,
  # so checking it afterwards would report every machine as user-pinned.
  local pinned="${CLAUDE_AGENTS_MODEL+yes}" pinned_value="${CLAUDE_AGENTS_MODEL:-}"
  # shellcheck source=libexec/lib.sh
  . "$LIBEXEC/lib.sh"
  if [ -n "$pinned" ]; then
    c_info "model pinned by environment: ${pinned_value:-<Claude Code default>} (not probing)"
  else
    echo "  • detecting a working model (one or two short calls)..."
    local detected rc=0
    detected="$(detect_model)" || rc=$?
    if [ "$rc" -ne 0 ]; then
      c_bad "no model responded — check \`claude -p 'hi'\` works, then re-run setup"
    else
      write_model_config "$detected"
      if [ -n "$detected" ]; then c_ok "model: $detected -> $CLAUDE_AGENTS_CONFIG"
      else c_ok "model: Claude Code's default -> $CLAUDE_AGENTS_CONFIG"; fi
    fi
  fi

  if [ "$(uname)" = "Darwin" ]; then
    local LA="$HOME/Library/LaunchAgents" PLIST
    PLIST="$LA/$PLIST_LABEL.plist"
    mkdir -p "$LA" "$HOME/Library/Logs"
    sed -e "s|REPLACE_WITH_ABSOLUTE_PATH|$LIBEXEC|g" \
        -e "s|REPLACE_WITH_HOME|$HOME|g" \
        "$PREFIX/com.user.mine-all-repos.plist" > "$PLIST"
    launchctl unload "$PLIST" >/dev/null 2>&1 || true
    launchctl load "$PLIST" >/dev/null 2>&1 || c_warn "couldn't load launchd agent"
    c_ok "daily miner loaded (runs now, then daily)"
  else
    c_warn "not macOS — add a cron entry for $LIBEXEC/mine-all-repos-cron.sh"
  fi
  echo; c_info "next: cd into a repo and run  claude-agents install"
}

# ---------------------------------------------------------------- install (repo)
cmd_install() {
  local repo="${1:-$PWD}"
  repo="$(cd "$repo" && git rev-parse --show-toplevel 2>/dev/null)" || die "not a git repo: ${1:-$PWD}"
  echo "Installing hooks into: $repo"
  local H="$repo/.git/hooks" HL
  HL="$(hook_libexec)"
  mkdir -p "$H" "$repo/.claude/review"

  local hook target
  for pair in "pre-commit:pre-commit.sh" \
              "prepare-commit-msg:prepare-commit-msg.sh" \
              "pre-push:pre-push.sh"; do
    hook="${pair%%:*}"; target="${pair##*:}"
    if [ -e "$H/$hook" ] && [ ! -L "$H/$hook" ]; then
      mv "$H/$hook" "$H/$hook.bak"; c_info "backed up $hook -> $hook.bak"
    fi
    ln -sf "$HL/$target" "$H/$hook"
    c_ok "$hook"
  done

  [ -f "$repo/.claude/review/STYLE_GUIDE.md" ] || cat > "$repo/.claude/review/STYLE_GUIDE.md" <<'EOF'
# Team style guide
# Concrete, checkable rules. The pre-push reviewer enforces these, and the
# interactive coding agent reads them before writing code.
EOF
  [ -f "$repo/.claude/review/BOUNDARIES.md" ] || cat > "$repo/.claude/review/BOUNDARIES.md" <<'EOF'
# Intended architecture / module boundaries
# State what may import what. The drift-watcher flags diffs that cross these.
EOF
  c_ok "seeded .claude/review/"
  (cd "$repo" && "$LIBEXEC/sync-lessons.sh" >/dev/null 2>&1) \
    || c_info "no lessons yet — run 'claude-agents mine' or wait for the daily run"
  echo; c_info "edit .claude/review/{STYLE_GUIDE,BOUNDARIES}.md to taste"
}

# ---------------------------------------------------------------- uninstall
cmd_uninstall() {
  echo "Removing machine wiring:"
  if [ "$(uname)" = "Darwin" ]; then
    local PLIST="$HOME/Library/LaunchAgents/$PLIST_LABEL.plist"
    launchctl unload "$PLIST" >/dev/null 2>&1 || true
    rm -f "$PLIST"; c_ok "removed launchd agent"
  fi
  c_info "left alone: ~/.claude/CLAUDE.md, $LESSONS_DIR, per-repo hooks"
  c_info "brew uninstall claude-agents removes the command itself"
}

# ---------------------------------------------------------------- status
cmd_status() {
  echo "claude-agents $VERSION"
  echo "  libexec: $LIBEXEC"
  echo
  echo "Machine:"
  [ -f "$HOME/.claude/CLAUDE.md" ] && c_ok "global CLAUDE.md present" || c_warn "no global CLAUDE.md (run: claude-agents setup)"
  if [ -d "$LESSONS_DIR" ]; then
    local n; n="$(find "$LESSONS_DIR" -name '*.md' 2>/dev/null | wc -l | tr -d ' ')"
    c_ok "lessons library: $n file(s) in $LESSONS_DIR"
    [ -f "$LESSONS_DIR/.last-run" ] && c_info "last mined PR: $(cat "$LESSONS_DIR/.last-run")"
  else
    c_warn "no lessons library yet"
  fi
  if [ "$(uname)" = "Darwin" ]; then
    if launchctl list 2>/dev/null | grep -q "$PLIST_LABEL"; then
      c_ok "daily miner loaded ($(launchctl list | awk -v l="$PLIST_LABEL" '$3==l {print "last exit "$2}'))"
    else
      c_warn "daily miner not loaded (run: claude-agents setup)"
    fi
    local log="$HOME/Library/Logs/mine-all-repos.log"
    [ -f "$log" ] && c_info "last log entry: $(grep '=====' "$log" | tail -1)"
  fi
  echo
  echo "This repo:"
  if git rev-parse --show-toplevel >/dev/null 2>&1; then
    local H; H="$(git rev-parse --show-toplevel)/.git/hooks"
    for h in pre-commit prepare-commit-msg pre-push; do
      if [ -L "$H/$h" ]; then
        [ -e "$H/$h" ] && c_ok "$h hooked" \
          || c_warn "$h symlink broken — target moved (run: claude-agents install)"
      else
        c_warn "$h not installed"
      fi
    done
  else
    c_info "not inside a git repo"
  fi
}

# ---------------------------------------------------------------- dispatch
case "${1:-}" in
  setup)      shift; cmd_setup "$@" ;;
  install)    shift; cmd_install "${1:-$PWD}" ;;
  uninstall)  shift; cmd_uninstall ;;
  mine)       shift; "$LIBEXEC/mine-all-repos.sh" "$@" ;;
  sync)       shift; "$LIBEXEC/sync-lessons.sh" "$@" ;;
  ask)        shift; "$LIBEXEC/ask.sh" "$@" ;;
  review)     shift; "$LIBEXEC/review.sh" "$@" ;;
  pr)         shift; "$LIBEXEC/pr.sh" "$@" ;;
  status)     shift; cmd_status ;;
  doctor)     shift; cmd_doctor "$@" ;;
  -v|--version) echo "claude-agents $VERSION" ;;
  ""|-h|--help) sed -n '4,15p' "$SELF" | sed 's/^# \{0,1\}//' ;;
  *) die "unknown command: $1 (try --help)" ;;
esac
